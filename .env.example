# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# LOCAL DEVELOPMENT - Use these individual variables
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=atousservice_db

# PRODUCTION - Use DATABASE_URL for Render/Vercel (comment out above when using this)
# Example format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://user:password@host:5432/database_name
# SSL for DATABASE_URL: verify (default) | no-verify (Render) | disable
# DATABASE_SSL=no-verify
# In production leave TYPEORM_SYNCHRONIZE unset: the tables are created by src/migrations at startup.

# ===========================================
# JWT CONFIGURATION
# ===========================================
# SECURITY: Generate a strong random secret for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 32 characters recommended, 64+ characters for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=1h

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8080
NODE_ENV=development

# Set to 'true' only for initial local setup. Use migrations for production.
# TYPEORM_SYNCHRONIZE=true

# Frontend URLs (comma-separated for CORS)
# Local: http://localhost:5173 (Vite default port)
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# ===========================================
# SWAGGER DOCUMENTATION AUTHENTICATION
# ===========================================
# SECURITY: Change these credentials in production!
# Swagger is only available in development mode (NODE_ENV !== 'production')
SWAGGER_USER=admin
SWAGGER_PASSWORD=change-this-strong-password-123

# ===========================================
# EMAIL CONFIGURATION (Optional - for sending notifications)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@atoutservice92.fr
# ADMIN_EMAIL=atouts.services92@gmail.com

# ===========================================
# CLOUD STORAGE (REQUIRED in production: the server disk is wiped on every deploy)
# ===========================================
# Uploaded photos go to an S3-compatible bucket instead of local disk.
# OVH Object Storage (Gravelines) example:
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=atouts-services-photos
# S3_REGION=gra
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# S3_OBJECT_ACL=public-read
# S3_CDN_URL=https://atouts-services-photos.s3.gra.io.cloud.ovh.net
# (Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, no S3_OBJECT_ACL)

# ===========================================
# NOTES
# ===========================================
# 1. For LOCAL development:
#    - Use DATABASE_HOST, DATABASE_PORT, etc.
#    - Make sure PostgreSQL is running locally
#    - Run: npm run start:dev
#
# 2. For PRODUCTION (Render/Vercel):
#    - Use DATABASE_URL only (don't set individual DB vars)
#    - Set environment variables in your hosting platform
#    - The app automatically detects DATABASE_URL and uses it
#
# 3. SECURITY CHECKLIST:
#    - NEVER commit the actual .env file to git (added to .gitignore)
#    - Generate a strong JWT_SECRET (min 64 characters for production)
#    - Change all default passwords (Swagger, database)
#    - Use HTTPS in production (NODE_ENV=production)
#    - Set strong database passwords
#    - Enable CORS only for trusted frontend domains
#
# 4. CREATING THE FIRST ADMIN USER:
#    - Run: npm run create:admin
#    - Follow the prompts to create your first admin user
#    - Registration endpoint is now protected and requires authentication

# Visitor analytics (docs/superpowers/specs/2026-09-25-visitor-analytics-design.md)
ANALYTICS_INGEST_KEY=generate-a-long-random-secret
